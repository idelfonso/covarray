{
  "name": "covarray-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "args": { "LLVM_VERSION": "23" }
  },
  // gdb, lldb and rr need ptrace; relax seccomp for debuggers and profilers
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "mounts": [
    "source=covarray-ccache,target=/home/dev/.cache/ccache,type=volume",
    "source=covarray-vcpkg,target=/home/dev/.cache/vcpkg,type=volume",
    "source=covarray-uv,target=/home/dev/.cache/uv,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/dev/.claude,type=volume"
  ],
  // Keep Claude Code sign-in and settings across rebuilds (.claude.json is written inside the volume)
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude"
  },
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "postCreateCommand": "sudo chown -R dev:dev /home/dev/.cache /home/dev/.claude && uv tool install pre-commit && pre-commit install || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "github.vscode-github-actions",
        "eamodio.gitlens"
      ],
      "settings": {
        "cmake.useCMakePresets": "always",
        "cmake.configureOnOpen": true,
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.arguments": [
          "--compile-commands-dir=${workspaceFolder}/build/dev",
          "--clang-tidy",
          "--header-insertion=never"
        ],
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff", "editor.formatOnSave": true },
        "[cpp]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd", "editor.formatOnSave": true }
      }
    }
  }
}
